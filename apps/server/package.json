{
    "name": "@bk/server",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun src/db/migrate.ts",
        "db:migrate:test": "bun --env-file=.env.test src/db/migrate.ts",
        "db:seed:superadmin": "bun src/db/seed-superadmin.ts",
        "test": "bun --env-file=.env.test test"
    },
    "dependencies": {
        "@bk/shared": "workspace:*",
        "dotenv": "^18.0.9",
        "drizzle-orm": "^0.44.0",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.3",
        "postgres": "^3.4.0",
        "valibot": "^1.5.0"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "drizzle-kit": "^0.31.0",
        "typescript": "^5.8.0"
    }
}
